# CoralFlow environment configuration
# Copy to .env and uncomment the sections you need:
#   cp .env.example .env
#
# Load order: repo-root .env first, then ./.env in your current directory (overrides).
# Agent/CLI persist interactive settings to repo-root .env only (not cwd .env).
# Local train / validate / predict work with no variables set.

# -----------------------------------------------------------------------------
# Google Cloud (optional — only for `coralflow train --cloud`, cost, cloud deploy)
# -----------------------------------------------------------------------------
# GCP_PROJECT=your-gcp-project-id
# GCP_LOCATION=us-central1
# GCP_STAGING_BUCKET=gs://your-staging-bucket
# GCP_FINETUNE_MODEL=gemini-2.0-flash-001
# GCP_VERTEX_MACHINE_TYPE=n1-standard-2

# Service account JSON (optional if you use `gcloud auth application-default login`)
# Relative paths resolve from the repo root.
# GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json

# -----------------------------------------------------------------------------
# Arize Phoenix — prediction tracing (optional)
# -----------------------------------------------------------------------------
# Local Phoenix (`pip install arize-phoenix && phoenix serve`):
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
# PHOENIX_PROJECT_NAME=edge-train

# Phoenix Cloud:
# PHOENIX_API_KEY=your-phoenix-api-key
# PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/v1/traces
# PHOENIX_PROJECT_NAME=edge-train

# -----------------------------------------------------------------------------
# Edge devices — for `coralflow deploy` and `coralflow-edge-pipeline`
# -----------------------------------------------------------------------------
# JSON array (recommended):
# EDGE_DEVICES=[{"device_id":"gw1","host":"192.168.1.50","port":8080}]
#
# Compact form (comma-separated):
# EDGE_DEVICES=gw1@192.168.1.50:8080,gw2@192.168.1.51:8080
#
# EDGE_DEFAULT_DEVICE=gw1

# Legacy JSON registry (used only when EDGE_DEVICES is empty):
# EDGE_REGISTRY_PATH=~/.edge-train/devices.json

# Edge gateway server (examples/edge_gateway only — not read by the CLI)
# EDGE_MODEL_PATH=/var/lib/coralflow/model.tflite
# EDGE_GATEWAY_HOST=0.0.0.0
# EDGE_GATEWAY_PORT=8080

# -----------------------------------------------------------------------------
# LLM agent (optional — only for `coralflow agent`)
# -----------------------------------------------------------------------------
# CORALFLOW_LLM_API_KEY=sk-your-key
# CORALFLOW_LLM_ENDPOINT=https://api.openai.com/v1
# CORALFLOW_LLM_MODEL=gpt-4o

# -----------------------------------------------------------------------------
# Paths & logs (optional overrides)
# -----------------------------------------------------------------------------
# EDGE_PREDICTION_LOG_PATH=./prediction_log.jsonl
# CORALFLOW_TRAINING_HISTORY_PATH=~/.coralflow/training_history.json
# CORALFLOW_DEPLOYMENTS_PATH=~/.coralflow/deployments.json
